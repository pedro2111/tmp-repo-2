components:
  schemas:
    AlteracaoBoletoRequestDTO:
      type: object
      properties:
        numeroDocumento:
          description: Número Documento
          default: "Ex: 123456"
          type: string
        dataVencimento:
          description: Data de Vencimento
          default: 2025-12-31
          type: string
          allOf:
          - $ref: '#/components/schemas/LocalDate'
        valor:
          description: Valor
          default: 9.99999999999999E12
          type: number
        tipoEspecie:
          format: int32
          description: Tipo Espécie
          default: "Informe o Id: 1-CHEQUE, 2-DUPLICATA MERCANTIL, 3-DUPLICATA MERCANTIL\
            \ POR INDICACAO, 4-DUPLICATA DE SERVICO, 5-DUPLICATA DE SERVICO POR INDICACAO,\
            \ 6-DUPLICATA RURAL, 7-LETRA DE CAMBIO, 8-NOTA DE CREDITO COMERCIAL, 9-NOTA\
            \ DE CREDITO A EXPORTACAO, 10-NOTA DE CREDITO INDUSTRIAL, 11-NOTA DE CREDITO\
            \ RURAL, 12-NOTA PROMISSORIA, 13-NOTA PROMISSORIA RURAL, 14-TRIPLICATA\
            \ MERCANTIL, 15-TRIPLICATA DE SERVICO, 16-NOTA DE SEGURO, 17-RECIBO, 18-BLOQUETO,\
            \ 19-NOTA DE DEBITO, 20-APOLICE DE SEGURO, 21-MENSALIDADE ESCOLAR, 22-PARCELA\
            \ DE CONSORCIO, 23-NOTA FISCAL, 24-DOCUMENTO DE DIVIDA, 25-CEDULA DE PRODUTO\
            \ RURAL, 31-CARTAO DE CREDITO, 32-BOLETO PROPOSTA, 33-BOLETO DE DEPOSITO\
            \ E APORTE, 81-INCLUSAO TESTE, 99-OUTROS."
          type: integer
        flagAceite:
          description: Flag Aceite
          default: Informe o A-Sim ou N-Não
          type: string
        JurosMora:
          description: Juros Mora
          type: object
          allOf:
          - $ref: '#/components/schemas/JurosMoraDTO'
        valorAbatimento:
          description: Valor Abatimento
          default: 9.99999999999999E12
          type: number
        posVencimento:
          description: Pos Vencimento
          type: object
          allOf:
          - $ref: '#/components/schemas/PosVencimentoDTO'
        pagador:
          description: Pagador
          type: object
          allOf:
          - $ref: '#/components/schemas/PagadorAlteraDTO'
        tpidentcsacdravalst:
          format: int32
          description: Tipo de Avalista
          default: "Informe o Id: 0-Isento / Não Informado, 1-CPF 2-CNPJ, 3-PIS/PASEP,\
            \ 9-Outros."
          type: integer
        avalista:
          description: Avalista
          type: object
          allOf:
          - $ref: '#/components/schemas/AvalistaDTO'
        endereco:
          description: Endereço
          type: object
          allOf:
          - $ref: '#/components/schemas/EnderecoDTO'
        multa:
          description: Multa
          type: object
          allOf:
          - $ref: '#/components/schemas/MultaDTO'
        descontos:
          description: Descontos
          type: object
          allOf:
          - $ref: '#/components/schemas/DescontosTituloDTO'
        valorIof:
          description: valorIof
          default: 999.99
          type: number
        identificacaoEmpresa:
          description: Identificação do titulo na empresa
          default: Campo destinado para uso da Empresa Beneficiário para identificação
            do Título
          type: string
        fichaCompensacao:
          description: Ficha de Compensação
          type: object
          allOf:
          - $ref: '#/components/schemas/FichaCompensacaoBoletoDTO'
        reciboPagador:
          description: "Texto de observações destinado ao envio de mensagens livres,\
            \ a serem impressas na parte Recibo do Pagador do boleto"
          type: object
          allOf:
          - $ref: '#/components/schemas/ReciboPagadorDTO'
        pagamento:
          description: Pagamento
          type: object
