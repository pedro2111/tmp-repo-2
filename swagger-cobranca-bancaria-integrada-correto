  /v1/beneficiario/{codBeneficiario}/escrituradora/historico:
    get:
      tags:
      - SIGCB - Histórico da Escrituradora
      summary: Consulta o histórico da situação contratual do beneficiário na escrituradora
      parameters:
      - name: codBeneficiario
        in: path
        required: true
        schema:
          format: int64
          type: integer
      responses:
        "200":
          description: OK
  /v1/beneficiarios/{nuCedente}/webhook:
    get:
      tags:
      - SIGCB - Manutenção de Boleto
      summary: Consulta a URL de webhook configurada para o beneficiário
      parameters:
      - name: nuCedente
        in: path
        required: true
        schema:
          format: int64
          type: integer
      responses:
        "200":
          description: OK
    post:
      tags:
      - SIGCB - Manutenção de Boleto
      summary: Cadastra ou atualiza a URL de webhook do beneficiário
      parameters:
      - name: nuCedente
        in: path
        required: true
        schema:
          format: int64
          type: integer
      - name: X-Request-ID
        in: header
        schema:
          type: string
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/NotificaURLDTO'
      responses:
        "200":
          description: OK
  /v1/cadastroURL:
    put:
      tags:
      - SIGCB - Manutenção de Boleto
      summary: Realizar o cadastramento/Atualizacao de URL de WEBHOOK de beneficiário
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/NotificaURLDTO'
      responses:
        "200":
          description: Sucesso
          content:
            application/json:
              schema:
                type: object
                properties:
                  idBeneficiario:
                    format: int64
                    description: Id do Beneficiário
                    type: integer
                    example: "Informe o Id do Beneficiário de 1 a 10 Caracteres Nú\
                      mericos Ex: 1100689"
                  cpfCnpj:
                    description: CPF ou CNPJ
                    default: "Ex: para CPF: 99999999999 ou para CNPJ: 99999999999999"
                    type: string
                  notificacaoURL:
                    description: Url da Notificação
                    default: "Ex: https://www.dominio.com.br/url_notificacao"
                    type: string
                  urlWebhook:
                    type: string
                  requestId:
                    type: string
        "401":
          description: Não Autorizado.
          content:
            application/json:
              schema:
                type: object
                properties:
                  negocial:
                    $ref: '#/components/schemas/NegocialDTO'
                  integracao:
                    $ref: '#/components/schemas/IntegracaoDTO'
        "400":
          description: Erro de sintaxe
          content:
            application/json:
              schema:
                type: object
                properties:
                  negocial:
                    $ref: '#/components/schemas/NegocialDTO'
                  integracao:
                    $ref: '#/components/schemas/IntegracaoDTO'
        "404":
          description: Beneficiário não encontrado
          content:
            application/json:
              schema:
                type: object
                properties:
                  negocial:
                    $ref: '#/components/schemas/NegocialDTO'
