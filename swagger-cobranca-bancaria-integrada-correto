---
openapi: 3.0.3
info:
  title: API Cobrança Bancária - Gestão de Boletos Integrada
  description: "# 1. Descrição: \n API Cobrança Bancária - Gestão de Boleto Integrada:\
    \ \nEste serviço permite a gestão dos boletos bancários do produto COBRANÇA BANCÁ\
    RIA CAIXA, \ndisponibilizando as funcionalidades de inclusão, alteração, baixa\
    \ e consulta de boletos bancários emitidos pela CAIXA."
  version: "1.0"
servers:
- url: https://api.des.caixa:8443/cobranca/boletos/
tags:
- name: SIGCB - Cancelamento/Exclusão da Negativação de Titulo
  description: 'Solicita a exclusao ou cancelamento da negativacao do titulo. '
- name: SIGCB - Histórico da Escrituradora
  description: Consulta o histórico da situação contratual do beneficiário.
- name: SIGCB - Integração SISNG
  description: Consulta e apropria simulações no SISNG.
- name: SIGCB - Manutenção de Boleto
  description: "Inclui, altera, consulta e realiza baixa em boletos."
paths:
  /incluiCarne:
    post:
      tags:
      - SIGCB - Manutenção de Boleto
      summary: Envia os dados de Boleto para inclusão do Boleto Carne
      operationId: incluiCarne
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/InclusaoTituloCarneDTO'
      responses:
        "200":
          description: Sucesso
          content:
            application/json:
              schema:
                type: object
                properties:
                  codigoRetorno:
                    description: Codigo Retorno
                    default: "0"
                    type: string
                  mensagemRetorno:
                    description: Mensagem do Sistema
                    default: OPERACAO EFETUADA
                    type: string
        "400":
          description: Erro de sintaxe
          content:
            application/json:
              schema:
                type: object
                properties:
                  negocial:
                    $ref: '#/components/schemas/NegocialDTO'
                  integracao:
                    $ref: '#/components/schemas/IntegracaoDTO'
        "401":
          description: Nao Autorizado
          content:
            application/json:
              schema:
                type: object
                properties:
                  negocial:
                    $ref: '#/components/schemas/NegocialDTO'
                  integracao:
                    $ref: '#/components/schemas/IntegracaoDTO'
        "404":
          description: Boleto não encontrado
          content:
            application/json:
              schema:
                type: object
                properties:
                  negocial:
                    $ref: '#/components/schemas/NegocialDTO'
                  integracao:
                    $ref: '#/components/schemas/IntegracaoDTO'
        "500":
          description: Erro servidor interno
          content:
            application/json:
              schema:
                type: object
                properties:
                  negocial:
                    $ref: '#/components/schemas/NegocialDTO'
                  integracao:
                    $ref: '#/components/schemas/IntegracaoDTO'
  /sisng/apropriar-simulacao:
    post:
      tags:
      - SIGCB - Integração SISNG
      summary: Apropria uma simulação no SISNG
      requestBody:
        content:
          text/plain:
            schema:
              type: string
      responses:
        "200":
          description: OK
  /sisng/consulta-simulacao:
    post:
      tags:
      - SIGCB - Integração SISNG
      summary: Consulta uma simulação no SISNG por número ou CNPJ
      requestBody:
        content:
          text/plain:
            schema:
              type: string
      responses:
        "200":
          description: OK
  /v1/alteraBoleto:
    post:
      tags:
      - SIGCB - Manutenção de Boleto
      summary: Envia os dados de Boleto para Alteração do Boleto
      parameters:
      - name: idBeneficiario
        in: query
        description: "Informe o Id do Beneficiário \n \n 1 a 10 Caracteres Númericos\
          \ Inteiros \n\n Ex: 1100689"
        required: true
        schema:
          pattern: "^\\d{1,10}$"
          type: string
      - name: nossoNumero
        in: query
        description: "Informe o Nosso Número \n \n 1 a 17 Caracteres Númericos Inteiros\
          \ \n\n Ex: 14000000010194476"
        required: true
        schema:
          pattern: "^\\d{1,17}$"
          type: string
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/AlteracaoBoletoRequestDTO'
      responses:
        "200":
          description: Sucesso
          content:
            application/json:
              schema:
                type: object
                properties:
                  codRetorno:
                    format: int32
                    description: Codigo Retorno
                    default: 0
                    type: integer
                  numCodBarras:
                    description: Número Código Barras
                    default: "10495131100000350001100036100100040000021928"
                    type: string
                  numLinhaDigTvl:
                    description: Número Linha Digitável
                    default: "10491100083610010004300000219287513110000035000"
                    type: string
                  urlBoleto:
                    description: URL Boleto
                    default: https://10.116.82.66:8010/ecobranca/SIGCB/imprimir/1100036/14100000000002192
                    type: string
                  qrCode:
                    description: String do QrCode
                    default: 00020101021226910014br.gov.bcb.pix2569pix-qrcode-h.caixa.gov.br/api/v2/cobv/CO011011000360141000000000021925204000053039865802BR5905teste6008PARACATU62070503***63049252
                    type: string
                  urlQrcode:
                    description: URL do QrCode
                    default: https://10.116.82.66:8010/ecobranca/SIGCB/imprimir/1100036/14100000000002192/qrcode
                    type: string
                  codErro:
                    format: int32
                    description: Código Erro
                    default: 0
                    type: integer
                  msgSistema:
                    description: Mensagem do Sistema
                    default: OPERACAO EFETUADA
                    type: string
        "401":
          description: Não Autorizado.
          content:
            application/json:
              schema:
                type: object
                properties:
                  negocial:
                    $ref: '#/components/schemas/NegocialDTO'
                  integracao:
                    $ref: '#/components/schemas/IntegracaoDTO'
        "400":
          description: Erro de sintaxe
          content:
            application/json:
              schema:
                type: object
                properties:
                  negocial:
                    $ref: '#/components/schemas/NegocialDTO'
                  integracao:
                    $ref: '#/components/schemas/IntegracaoDTO'
        "404":
          description: Boleto não encontrado
          content:
            application/json:
              schema:
                type: object
                properties:
                  negocial:
                    $ref: '#/components/schemas/NegocialDTO'
                  integracao:
                    $ref: '#/components/schemas/IntegracaoDTO'
        "500":
          description: Erro servidor interno
