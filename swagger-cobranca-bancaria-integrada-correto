  /v1/cancelamento-negativacao:
    put:
      tags:
      - SIGCB - Cancelamento/Exclusão da Negativação de Titulo
      summary: Envia os dados do título para exclusão ou cancelamento da negativação
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/NegativacaoDTO'
      responses:
        "200":
          description: Sucesso
          content:
            application/json:
              schema:
                type: object
                properties:
                  origem:
                    description: Origem da Resposta
                    default: Método de Resposta do Erro
                    type: string
                  codigo:
                    description: codigo da Resposta
                    default: "99"
                    type: string
                  mensagem:
                    description: Mensagem da Resposta
                    default: Mensagem genérica de acordo com o erro do método
                    type: string
                  excecao:
                    description: Erro de Excessão da Resposta
                    default: Descricao da resposta de exceção de falhas
                    type: string
                  exception:
                    format: int32
                    description: statusType
                    default: 200
                    type: integer
        "401":
          description: Não autorizado
          content:
            application/json:
              schema:
                type: object
                properties:
                  negocial:
                    $ref: '#/components/schemas/NegocialDTO'
                  integracao:
                    $ref: '#/components/schemas/IntegracaoDTO'
        "400":
          description: Erro de sintaxe
